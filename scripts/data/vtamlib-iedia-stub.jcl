//IEDSTUB  JOB (1),'VTAM STUBS',CLASS=A,MSGCLASS=A,MSGLEVEL=(1,1),
//         USER=MVSCE01,PASSWORD=CUL8TR
//ASM      EXEC PGM=IFOX00,REGION=1024K,PARM='OBJ,NODECK'
//SYSLIB   DD DSN=SYS1.MACLIB,DISP=SHR
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT2   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSUT3   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSPRINT DD SYSOUT=A
//SYSPUNCH DD DUMMY
//SYSGO    DD DSN=&&OBJ,UNIT=SYSDA,SPACE=(TRK,(2,2)),DISP=(,PASS)
//SYSIN    DD *
IEDIAE   CSECT
*  webmvs: stub for the TCAM device module IEDIAE that the VTAM
*  RDVT modules ISTYTCM1-3 name; this system has no TCAM. Never called.
         SR    15,15
         BR    14
         END
/*
//LKED     EXEC PGM=IEWL,PARM='LIST,LET,RENT,REUS,REFR',COND=(0,NE)
//SYSPRINT DD SYSOUT=A
//SYSUT1   DD UNIT=SYSDA,SPACE=(CYL,(1,1))
//SYSLMOD  DD DSN=SYS1.VTAMLIB,DISP=SHR
//OBJ      DD DSN=&&OBJ,DISP=(OLD,DELETE)
//SYSLIN   DD *
 INCLUDE OBJ
 ALIAS IEDIAK
 NAME IEDIAE(R)
/*
//
