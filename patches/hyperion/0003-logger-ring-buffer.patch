diff --git a/logger.h b/logger.h
index 216a0f24..2a05a5a2 100644
--- a/logger.h
+++ b/logger.h
@@ -65,6 +65,14 @@ extern int logger_syslogfd[2];      // logger pipe file descriptors
 #define LOG_READ           0        // read  end of logger pipe
 #define LOG_WRITE          1        // write end of logger pipe
 
+#if defined( __EMSCRIPTEN__ )
+/* Emscripten pipes never block, so the logger uses an in-memory     */
+/* ring buffer with a condition variable instead of pipe + dup2.     */
+/* Returns the number of bytes written, or -1 if the logger is not   */
+/* active or stays full (the caller then writes to the screen).      */
+LOGR_DLL_IMPORT int    logger_ring_write( const char* msg, int len );
+#endif
+
 /*-------------------------------------------------------------------*/
 
 #endif /* __LOGGER_H__ */
