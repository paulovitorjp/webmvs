 static char  logger_filename[MAX_PATH];
 
+#if defined( __EMSCRIPTEN__ )
+/*-------------------------------------------------------------------*/
+/*  Emscripten: ring buffer in place of the logger pipe              */
+/*-------------------------------------------------------------------*/
+/* Emscripten pipes never block (EAGAIN in PIPEFS, 0 in WasmFS) and  */
+/* stdout cannot be dup2'ed onto a pipe in a useful way, so writers  */
+/* (logmsg.c do_write_pipe) put the bytes into this ring, and the    */
+/* logger thread waits on a condition until bytes are available.     */
+/* stdout and stderr are not redirected (they go to Module.print).   */
+#define LOGGER_RING_SIZE  (256 * 1024)
+static LOCK  ring_lock;
+static COND  ring_cond;
+static char  ring_buf[ LOGGER_RING_SIZE ];
+static int   ring_head = 0;             /* next byte to read         */
+static int   ring_count = 0;            /* bytes in the ring         */
+
+DLL_EXPORT int logger_ring_write( const char* msg, int len )
+{
+    int tries, n, first;
+
+    if (!logger_init_flg || len <= 0)
+        return len <= 0 ? 0 : -1;
+
+    for (tries = 0; tries < 50; tries++)
+    {
+        obtain_lock( &ring_lock );
+        {
+            if (!logger_active)
+            {
+                release_lock( &ring_lock );
+                return -1;
+            }
+            if (LOGGER_RING_SIZE - ring_count >= len)
+            {
+                int tail = (ring_head + ring_count) % LOGGER_RING_SIZE;
+                n = len;
+                first = LOGGER_RING_SIZE - tail;
+                if (first > n) first = n;
+                memcpy( ring_buf + tail, msg, first );
+                if (n > first)
+                    memcpy( ring_buf, msg + first, n - first );
+                ring_count += n;
+                signal_condition( &ring_cond );
+                release_lock( &ring_lock );
+                return len;
+            }
+        }
+        release_lock( &ring_lock );
+        USLEEP( 10000 );    /* logger is backlogged; wait a bit */
+    }
+    return -1;
+}
+
+/* Blocking read of up to 'max' bytes from the ring (logger thread)  */
+static int logger_ring_read( char* buf, int max )
+{
+    int n, first;
+
+    obtain_lock( &ring_lock );
+    {
+        while (!ring_count)
+            wait_condition( &ring_cond, &ring_lock );
+
+        n = ring_count < max ? ring_count : max;
+        first = LOGGER_RING_SIZE - ring_head;
+        if (first > n) first = n;
+        memcpy( buf, ring_buf + ring_head, first );
+        if (n > first)
+            memcpy( buf + first, ring_buf, n - first );
+        ring_head = (ring_head + n) % LOGGER_RING_SIZE;
+        ring_count -= n;
+    }
+    release_lock( &ring_lock );
+    return n;
+}
+#endif /* defined( __EMSCRIPTEN__ ) */
+
 /*********************************************************************/
 /*              log_read  -  read system log                         */
 /*********************************************************************/
