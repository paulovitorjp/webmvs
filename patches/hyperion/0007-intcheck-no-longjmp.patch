@@ -2049,6 +2049,9 @@ int     aswitch;
         DO_AUTOMATIC_TRACING();
     }
 
+    /* An instruction that ended with RETURN_INTCHECK continues here */
+intcheck_resume:
+
     /* Set `execflag' to 0 in case EXecuted instruction did a longjmp() */
     regs->execflag = 0;
 
@@ -2107,6 +2110,12 @@ enter_fastest_no_txf_loop:
 
     /* Perform automatic instruction tracing if it's enabled */
     DO_AUTOMATIC_TRACING();
+    /* Instruction ended with RETURN_INTCHECK? (see opcode.h) */
+    if (regs->intcheck)
+    {
+        regs->intcheck = 0;
+        goto intcheck_resume;
+    }
     goto fastest_no_txf_loop;
 
 #if defined( FEATURE_073_TRANSACT_EXEC_FACILITY )
@@ -2144,6 +2153,12 @@ enter_txf_faster_loop:
 
     /* Perform automatic instruction tracing if it's enabled */
     DO_AUTOMATIC_TRACING();
+    /* Instruction ended with RETURN_INTCHECK? (see opcode.h) */
+    if (regs->intcheck)
+    {
+        regs->intcheck = 0;
+        goto intcheck_resume;
+    }
 
 //txf_slower_loop:
 
@@ -2178,6 +2193,12 @@ enter_txf_slower_loop:
 
     /* Perform automatic instruction tracing if it's enabled */
     DO_AUTOMATIC_TRACING();
+    /* Instruction ended with RETURN_INTCHECK? (see opcode.h) */
+    if (regs->intcheck)
+    {
+        regs->intcheck = 0;
+        goto intcheck_resume;
+    }
     goto txf_facility_loop;
 
 #endif /* defined( FEATURE_073_TRANSACT_EXEC_FACILITY ) */
