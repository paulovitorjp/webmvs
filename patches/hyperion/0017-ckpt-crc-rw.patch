+    /* 1.8 MiB per checkpoint between GCs, +120-150 MiB/h in the 60-min */
+    /* soak). A read-write open uses a sync access handle that reads    */
+    /* into wasm memory. Nothing is written; native: the same reads.    */
+    int     fd = HOPEN( path, O_RDWR | O_BINARY );
     if (fd < 0)
         return -1;
     while ((n = read( fd, buf, sizeof( buf ))) > 0)
