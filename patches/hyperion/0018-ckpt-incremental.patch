+            if (!ck_chg[p]) { p++; continue; }
+            for (q = p; q < np && ck_chg[q]; q++) ;
+            store_fw( rh, (U32) p );
+            store_fw( rh + 4, (U32)(q - p) );
+            if (SR_WRITE( rh, 1, 8, file ) != 8)
+            {
+                sr_write_error_();
+                return -1;
+            }
+            for (off = p * CK_PAGE; off < q * CK_PAGE; )
+            {
+                U32 n = (U32) MIN( (U64) SR_BUF_CHUNKSIZE, q * CK_PAGE - off );
+                if ((U32) SR_WRITE( sysblk.mainstor + off, 1, n, file ) != n)
+                {
+                    sr_write_error_();
+                    return -1;
+                }
+                off += n;
+            }
+            p = q;
+        }
+        return 0;
+    }
+    SR_WRITE_BUF( file, SR_SYS_MAINSTOR, sysblk.mainstor, sysblk.mainsize );
+    return 0;
+}
