+/* Delta of one shadow file: record 'F' (name, size, number of runs), */
+/* then each run (offset, length, data). All numbers little endian.  */
+static int cckd_ckpt_delta_file( CCKD_EXT* cckd, int sfx, const char* name,
+                                 CKDLT* w, U64* size, U64* dbytes,
+                                 char* err, size_t errlen )
+{
+    struct stat st;
+    U32*   map = cckd->ckmap[ sfx ];
+    U64    nblk, b, total;
+    U32    nruns = 0;
+    BYTE   hdr[ 16 ];
+    BYTE*  buf;
+    size_t nl = strlen( name );
+    int    pass;
+
+    if (fstat( cckd->fd[ sfx ], &st ) < 0)
+    {
+        snprintf( err, errlen, "fstat: %s", strerror( errno ));
+        return -1;
+    }
+    total = (U64) st.st_size;
+    if (total > CKMAP_MAXBYTES)
+    {
+        snprintf( err, errlen, "%s: larger than the tracked size", name );
+        return -1;
+    }
+    nblk = (total + CKMAP_BLK - 1) / CKMAP_BLK;
+#define CKBIT( _b ) (map && (map[ (_b) >> 5 ] & ((U32)1 << ((_b) & 31))))
+    for (b = 0; b < nblk; b++)
+        if (CKBIT( b ) && (b == 0 || !CKBIT( b - 1 )))
+            nruns++;
+    if (!(buf = malloc( 256 * 1024 )))
+    {
+        snprintf( err, errlen, "malloc: %s", strerror( errno ));
+        return -1;
+    }
+    hdr[0] = 'F'; ckdlt_le( hdr + 1, nl, 2 );
+    if (ckdlt_put( w, hdr, 3 ) < 0 || ckdlt_put( w, name, nl ) < 0)
+        goto dlt_werr;
+    ckdlt_le( hdr, total, 8 ); ckdlt_le( hdr + 8, nruns, 4 );
+    if (ckdlt_put( w, hdr, 12 ) < 0)
+        goto dlt_werr;
+    *dbytes = 0;
+    for (b = 0, pass = 0; b < nblk; )
+    {
+        U64 s, e, off, len;
+        if (!CKBIT( b )) { b++; continue; }
+        s = b;
+        while (b < nblk && CKBIT( b )) b++;
+        e = b;
+        off = s * CKMAP_BLK;
+        len = MIN( e * CKMAP_BLK, total ) - off;
+        ckdlt_le( hdr, off, 8 ); ckdlt_le( hdr + 8, len, 4 );
+        if (ckdlt_put( w, hdr, 12 ) < 0)
+            goto dlt_werr;
+        while (len)
+        {
+            size_t  want = (size_t) MIN( (U64)(256 * 1024), len );
+            ssize_t n = pread( cckd->fd[ sfx ], buf, want, (off_t) off );
+            if (n <= 0)
+            {
+                snprintf( err, errlen, "%s: read: %s", name, n < 0 ? strerror( errno ) : "short file" );
+                free( buf );
+                return -1;
+            }
+            if (ckdlt_put( w, buf, (size_t) n ) < 0)
+                goto dlt_werr;
+            off += (U64) n; len -= (U64) n; *dbytes += (U64) n;
+        }
+        pass++;
+    }
+#undef CKBIT
+    free( buf );
+    *size = total;
+    return (int) pass;
+dlt_werr:
+    snprintf( err, errlen, "write delta: %s", strerror( errno ));
+    free( buf );
+    return -1;
+}
