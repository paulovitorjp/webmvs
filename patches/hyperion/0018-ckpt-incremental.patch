 /*-------------------------------------------------------------------*/
+/*-------------------------------------------------------------------*/
+/* Incremental                                                       */
+/* checkpoints. Every write to a CCKD file (cckd_write, and the cut  */
+/* part of an ftruncate) marks its 4 KB blocks in a per-file bitmap  */
+/* (allocated at the first write: every write since Hercules opened  */
+/* the file is in it). A full checkpoint copies the file and clears  */
+/* the bitmap (both under the I/O and file locks); a delta           */
+/* checkpoint writes only the marked blocks (cumulative since that   */
+/* full copy = the "base") into one delta file. Base copy + delta =  */
+/* the file at the delta checkpoint, byte for byte. Files larger     */
+/* than CKMAP_MAXBYTES, a re-opened file or a failed allocation set  */
+/* ckover: the next checkpoint must be full.                         */
+/*-------------------------------------------------------------------*/
+static void cckd_ckmark( CCKD_EXT* cckd, int sfx, U64 off, U64 len )
+{
+    U32* map;
+    U64  b, e;
+
+    if (sfx < 0 || sfx > CCKD_MAX_SF || len == 0)
+        return;
+    if (!(map = cckd->ckmap[ sfx ]))
+    {
+        U32* p = calloc( CKMAP_WORDS, sizeof( U32 ));
+        if (!p)
+        {
+            cckd->ckover[ sfx ] = 1;
+            return;
+        }
+        if (!__sync_bool_compare_and_swap( &cckd->ckmap[ sfx ], NULL, p ))
+            free( p );
+        map = cckd->ckmap[ sfx ];
+    }
+    if (off + len > CKMAP_MAXBYTES)
+    {
+        cckd->ckover[ sfx ] = 1;
+        if (off >= CKMAP_MAXBYTES)
+            return;
+        len = CKMAP_MAXBYTES - off;
+    }
+    b = off / CKMAP_BLK;
+    e = (off + len - 1) / CKMAP_BLK;
+    for (; b <= e; b++)
+        __sync_fetch_and_or( &map[ b >> 5 ], (U32)1 << (b & 31) );
+}
+
+/* Writer of the delta file: running crc32 and byte count (CKDLT in  */
+/* cckddasd.h; sr.c writes the header and the end record)            */
+DLL_EXPORT int ckdlt_put( CKDLT* w, const void* buf, size_t len )
+{
+    const BYTE* p = buf;
+    size_t      left = len;
+    while (left)
+    {
+        ssize_t n = write( w->fd, p, left );
+        if (n <= 0)
+            return -1;
+        p += n; left -= (size_t) n;
+    }
+    w->crc = crc32( w->crc, buf, (uInt) len );
+    w->bytes += len;
+    return 0;
+}
+DLL_EXPORT void ckdlt_le( BYTE* p, U64 v, int n )
+{
+    int i;
+    for (i = 0; i < n; i++) { p[i] = (BYTE)(v & 0xff); v >>= 8; }
+}
+
+/* Dirty bytes of a device's shadow files since the last full copy;  */
+/* -1 = not tracked completely (the next checkpoint must be full).   */
+DLL_EXPORT S64 cckd_ckpt_dirty( DEVBLK* dev )
+{
+    CCKD_EXT* cckd = dev->cckd_ext;
+    S64       n = 0;
+    int       i, w;
+    if (!cckd || dev->cckd64)
+        return -1;
+    for (i = 1; i <= cckd->sfn; i++)
+    {
+        U32* map = cckd->ckmap[ i ];
+        if (cckd->ckover[ i ] || !cckd->ckbase[ i ])
+            return -1;
+        if (!map)
+            continue;
+        for (w = 0; w < CKMAP_WORDS; w++)
+            if (map[ w ])
+                n += (S64) __builtin_popcount( map[ w ] ) * CKMAP_BLK;
+    }
+    return n;
+}
+
+/* After 'resume ... track=1': the live shadow files are the base's  */
+/* copies (+ the delta of the resumed slot, marked by the caller     */
+/* through cckd_ckpt_markrange). Writes since the open are in the    */
+/* bitmaps already; from now on deltas against that base are valid.  */
+DLL_EXPORT void cckd_ckpt_adopt( DEVBLK* dev )
+{
+    CCKD_EXT* cckd = dev->cckd_ext;
+    int       i;
+    if (!cckd)
+        return;
+    for (i = 1; i <= cckd->sfn; i++)
+        cckd->ckbase[ i ] = 1;
+}
+/* bytes of the device's shadow files now                            */
+DLL_EXPORT U64 cckd_ckpt_size( DEVBLK* dev )
+{
+    CCKD_EXT*   cckd = dev->cckd_ext;
+    struct stat st;
+    U64         n = 0;
+    int         i;
+    if (!cckd)
+        return 0;
+    for (i = 1; i <= cckd->sfn; i++)
+        if (cckd->fd[i] >= 0 && fstat( cckd->fd[i], &st ) == 0)
+            n += (U64) st.st_size;
+    return n;
+}
+/* index (1..sfn) of the shadow file with this base name, or 0       */
+DLL_EXPORT int cckd_ckpt_findname( DEVBLK* dev, const char* name )
+{
+    CCKD_EXT* cckd = dev->cckd_ext;
+    int       i;
+    if (!cckd)
+        return 0;
+    for (i = 1; i <= cckd->sfn; i++)
+    {
+        const char* sf = cckd_sf_name( dev, i );
+        const char* b;
+        if (!sf)
+            continue;
+        b = strrchr( sf, '/' );
+        b = b ? b + 1 : sf;
+        if (!strcmp( b, name ))
+            return i;
+    }
+    return 0;
+}
+DLL_EXPORT void cckd_ckpt_markrange( DEVBLK* dev, int sfx, U64 off, U64 len )
+{
+    if (dev->cckd_ext)
+        cckd_ckmark( dev->cckd_ext, sfx, off, len );
+}
