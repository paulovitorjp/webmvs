+/* dirname of a path into buf ("." if none)                          */
+static void ck_dirname( const char* path, char* buf, size_t len )
+{
+    const char* s = strrchr( path, '/' );
+    if (!s)                { snprintf( buf, len, "." ); return; }
+    if (s == path)         { snprintf( buf, len, "/" ); return; }
+    snprintf( buf, len, "%.*s", (int)(s - path), path );
+}
+
+static U64 ck_le( const BYTE* p, int n )
+{
+    U64 v = 0;
+    while (n--) v = (v << 8) | p[n];
+    return v;
+}
+
+/* Main storage in the .srf: stock (one buffer), full with the page  */
+/* hashes of exactly the bytes written (copied first), or a delta:   */
+/* SR_SYS_MSBASE (the base's .srf) + SR_SYS_MSDELTA (runs of pages:  */
+/* first page, count (4 bytes each, big endian), the pages).         */
+static int sr_write_mainstor( SR_FILE file )
+{
+    static BYTE tmp[ 64 * 1024 ];
+    U64  np = sysblk.mainsize / CK_PAGE, p, q, off, total = 0;
+    BYTE rh[ 8 ];
