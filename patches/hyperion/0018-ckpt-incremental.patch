+    {
+        BYTE  h[ 16 ];
+        char  name[ 256 ];
+        FILE* f;
+        ck_dirname( fn, d, sizeof( d ));
+        snprintf( dlt, sizeof( dlt ), "%s/shadows.dlt", d );
+        ok = 0;
+        if ((f = fopen( dlt, "rb" )))
+        {
+            ok = fread( h, 1, 8, f ) == 8 && !memcmp( h, "MVSCKDL1", 8 );
