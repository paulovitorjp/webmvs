+    if (ck_ms.mode == 1)
+    {
+        SR_WRITE_HDR( file, SR_SYS_MAINSTOR, sysblk.mainsize );
+        for (off = 0; off < sysblk.mainsize; off += sizeof( tmp ))
+        {
+            U32 n = (U32) MIN( (U64) sizeof( tmp ), sysblk.mainsize - off ), k;
+            memcpy( tmp, sysblk.mainstor + off, n );
+            for (k = 0; k + CK_PAGE <= n; k += CK_PAGE)
+                ck_hash2[ (off + k) / CK_PAGE ] = ck_page_hash( tmp + k );
+            if ((U32) SR_WRITE( tmp, 1, n, file ) != n)
+            {
+                sr_write_error_();
+                return -1;
+            }
+        }
+        return 0;
+    }
+    if (ck_ms.mode == 2)
+    {
+        SR_WRITE_STRING( file, SR_SYS_MSBASE, ck_ms.basesrf );
+        for (p = 0; p < np; )
+        {
+            if (!ck_chg[p]) { p++; continue; }
+            for (q = p; q < np && ck_chg[q]; q++) ;
+            total += 8 + (q - p) * CK_PAGE;
+            p = q;
+        }
+        if (total > 0xFFFFFFF0ULL)
+        {
