+/* (re)allocate the page arrays for this main storage size           */
+static int ck_alloc()
+{
+    U64 np = sysblk.mainsize / CK_PAGE;
+    if (np == ck_npages && ck_hash && ck_hash2 && ck_chg)
+        return 0;
+    free( ck_hash ); free( ck_hash2 ); free( ck_chg );
+    ck_hash  = calloc( np ? np : 1, sizeof( U64 ));
+    ck_hash2 = calloc( np ? np : 1, sizeof( U64 ));
+    ck_chg   = calloc( np ? np : 1, 1 );
+    ck_npages = np;
+    ck_valid = 0;
+    if (!ck_hash || !ck_hash2 || !ck_chg)
+    {
+        free( ck_hash ); free( ck_hash2 ); free( ck_chg );
+        ck_hash = ck_hash2 = NULL; ck_chg = NULL; ck_npages = 0;
+        return -1;
+    }
+    return 0;
+}
