+/*-------------------------------------------------------------------*/
+/* Incremental                                                       */
+/* checkpoints. 'checkpoint <dir> incr=1 base=<dir0>' writes a DELTA */
+/* when <dir0> is the last full checkpoint of this process (or the   */
+/* slot that 'resume ... track=1' adopted): only the 4 KB pages of   */
+/* main storage whose hash differs from the base's, and only the     */
+/* blocks of the shadow files written since the base copy (cckd      */
+/* bitmaps, cckddasd.c), into <dir>/shadows.dlt. A delta is always   */
+/* against the base, never against another delta (restore = base +   */
+/* one delta). Without a usable base, or when the delta would be     */
+/* larger than maxdelta= percent of the base, it writes a full one.  */
+/*-------------------------------------------------------------------*/
+#define CK_PAGE 4096
+/* progress of 'checkpoint' for an embedder that must wait for it     */
+/* without a lock (the browser page in pagehide): 4 * (checkpoints     */
+/* ended, ok or failed) + phase (0 idle, 1 CPUs stopped, 2 after the  */
+/* pause, writing the manifest)                                       */
+DLL_EXPORT volatile U32 sr_ckpt_progress = 0;
+#define CK_PHASE( _p ) (sr_ckpt_progress = (sr_ckpt_progress & ~3u) | (_p))
+#define CK_ENDED()     (sr_ckpt_progress = (sr_ckpt_progress & ~3u) + 4)
+static char  ck_base[ MAX_PATH ] = "";  /* dir of the base checkpoint */
+static int   ck_valid  = 0;             /* deltas against ck_base ok  */
+static U64*  ck_hash   = NULL;          /* page hashes of the base    */
+static U64*  ck_hash2  = NULL;          /* (next full: new hashes)    */
+static BYTE* ck_chg    = NULL;          /* pages that differ          */
+static U64   ck_npages = 0;
+static U64   ck_base_shbytes = 0;       /* bytes of the base copies   */
+static int   ck_ndelta = 0;             /* deltas since the base      */
+static struct { int mode; const char* basesrf; U64 nchg; } ck_ms;  /* 0 stock, 1 full+hash, 2 delta */
+
+/* XXH64 of one 4 KB page (each round is a bijection of the word,   */
+/* so a change of a single 8-byte word always changes the hash)      */
+#define CK_P1 0x9E3779B185EBCA87ULL
+#define CK_P2 0xC2B2AE3D27D4EB4FULL
+#define CK_P3 0x165667B19E3779F9ULL
+#define CK_P4 0x85EBCA77C2B2AE63ULL
+#define CK_P5 0x27D4EB2F165667C5ULL
+#define CK_ROTL( x, r ) (((x) << (r)) | ((x) >> (64 - (r))))
+static INLINE U64 ck_round( U64 acc, U64 in ) { acc += in * CK_P2; acc = CK_ROTL( acc, 31 ); return acc * CK_P1; }
+static INLINE U64 ck_merge( U64 h, U64 v ) { h ^= ck_round( 0, v ); return h * CK_P1 + CK_P4; }
+static U64 ck_page_hash( const BYTE* p )
+{
+    U64 v1 = CK_P1 + CK_P2, v2 = CK_P2, v3 = 0, v4 = 0 - CK_P1, h, w[4];
+    int i;
+    for (i = 0; i < CK_PAGE; i += 32)
+    {
+        memcpy( w, p + i, 32 );
+        v1 = ck_round( v1, w[0] ); v2 = ck_round( v2, w[1] );
+        v3 = ck_round( v3, w[2] ); v4 = ck_round( v4, w[3] );
+    }
+    h = CK_ROTL( v1, 1 ) + CK_ROTL( v2, 7 ) + CK_ROTL( v3, 12 ) + CK_ROTL( v4, 18 );
+    h = ck_merge( h, v1 ); h = ck_merge( h, v2 ); h = ck_merge( h, v3 ); h = ck_merge( h, v4 );
+    h += CK_PAGE;
+    h ^= h >> 33; h *= CK_P2; h ^= h >> 29; h *= CK_P3; h ^= h >> 32;
+    return h;
+}
