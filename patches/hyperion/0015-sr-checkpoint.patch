@@ -1964,10 +1985,148 @@ static void loc3270_halt_or_clear( DEVBLK* dev )
 /*-------------------------------------------------------------------*/
 /*          Hercules Suspend Routine for 3270 devices                */
 /*-------------------------------------------------------------------*/
+/*-------------------------------------------------------------------*/
+/* Read Buffer for suspend/checkpoint, with a time                   */
+/* limit and without losing terminal input.                          */
+/*                                                                   */
+/* suspend/checkpoint run on the command thread, not in a channel    */
+/* program, so input can be in the way: (1) a record that the        */
+/* connection thread already received but that MVS has not read yet */
+/* (attention pending, readpending set): the stock code overwrote it */
+/* with the Read Buffer reply, so the keystroke was lost and the     */
+/* terminal stayed locked (X SYSTEM); (2) an AID that the user sends */
+/* while our Read Buffer is under way: the stock code took it as the */
+/* reply. Here (1) is saved and put back, and a record that is not a */
+/* Read Buffer reply (AID other than X'60' and shorter than a model 2*/
+/* buffer) is kept and given to MVS as input afterwards (attention). */
+/* Returns 0 = reply in dev->buf, CSW_UC = connection error, 0xFF =  */
+/* no complete reply within ms. *extra = a kept input record or NULL.*/
+/* The caller holds the device lock.                                 */
+/*-------------------------------------------------------------------*/
+#define SR_3270_MIN_RB  (3 + 24 * 80)   /* AID + cursor + 1920 bytes */
+
+/* Take the first complete record out of dev->buf into a new buffer  */
+static BYTE* sr_3270_pop_record( DEVBLK* dev, int* reclen )
+{
+    TELNET* tn = dev->tn;
+    int     len = tn->eor_pos[0], i;
+    BYTE*   rec;
+
+    if (len < 0 || len > (int) dev->rlen3270)
+        len = (int) dev->rlen3270;
+    rec = malloc( len > 0 ? len : 1 );
+
+    if (rec && len > 0)
+        memcpy( rec, dev->buf, len );
+    *reclen = len;
+    memmove( dev->buf, dev->buf + len, dev->rlen3270 - len );
+    dev->rlen3270 -= len;
+    if (tn->eor_cnt > 4)            /* positions lost: assume the rest */
+        tn->eor_cnt = 4;            /* is one complete record          */
+    for (i = 1; i < tn->eor_cnt; i++)
+        tn->eor_pos[i-1] = tn->eor_pos[i] - len;
+    tn->eor_cnt--;
+    if (tn->eor_cnt > 0 && tn->eor_pos[ tn->eor_cnt - 1 ] > (int) dev->rlen3270)
+        tn->eor_pos[ tn->eor_cnt - 1 ] = (int) dev->rlen3270;
+    tn->got_eor = tn->eor_cnt > 0;
+    return rec;
+}
+
+static BYTE  solicit_3270_rb_timed( DEVBLK* dev, int ms, BYTE** reply, int* replylen,
+                                    BYTE** extra, int* extralen )
+{
+    struct timeval  start, now, tv;
+    fd_set          rset;
+    BYTE            status;
+    BYTE*           rec;
+    int             left, rc, len, dropped = 0;
+
+    *reply = NULL; *replylen = 0;
+    *extra = NULL; *extralen = 0;
+    dev->rlen3270     = 0;
+    dev->readpending  = 0;
+    dev->tn->got_eor  = FALSE;
+    dev->tn->eor_cnt  = 0;
+
+    telnet_3270_cmd( dev->tn->ctl, R3270_RB );
+
+    if (dev->tn->send_err)
+    {
+        disconnect_console_device( dev );
+        dev->sense[0] = SENSE_DC;
+        return (CSW_UC);
+    }
+
+    gettimeofday( &start, NULL );
+    for (;;)
+    {
+        /* Sort the complete records: the Read Buffer reply (AID X'60'  */
+        /* or a whole buffer), or user input (AID record) to keep       */
+        while (dev->tn->eor_cnt > 0)
+        {
+            rec = sr_3270_pop_record( dev, &len );
+            if (!rec)
+                continue;
+            if (!*reply && len > 0 && (rec[0] == 0x60 || len >= SR_3270_MIN_RB))
+            {
+                *reply = rec; *replylen = len;
+            }
+            else if (!*extra && len > 0)
+            {
+                *extra = rec; *extralen = len;
+            }
+            else
+            {
+                free( rec );
+                dropped++;
+            }
+        }
+        if (*reply && dev->rlen3270 == 0)
+            break;                      /* reply, no partial record  */
+
+        gettimeofday( &now, NULL );
+        left = ms - (int)((now.tv_sec - start.tv_sec) * 1000
+                        + (now.tv_usec - start.tv_usec) / 1000);
+        if (left <= 0)
+            break;
+        FD_ZERO( &rset );
+        FD_SET( dev->fd, &rset );
+        tv.tv_sec  = left / 1000;
+        tv.tv_usec = (left % 1000) * 1000;
+        rc = select( dev->fd + 1, &rset, NULL, NULL, &tv );
+        if (rc < 0 && HSO_errno == HSO_EINTR)
+            continue;
+        if (rc == 0)
+            break;
+        if (rc < 0)
+            return (BYTE) CSW_UC;
+        dev->readpending = 0;           /* keep what is in dev->buf  */
+        status = recv_3270_data( dev );
+        if (status & CSW_UC)
+        {
+            disconnect_console_device( dev );
+            dev->sense[0] = SENSE_DC;
+            return (CSW_UC);
+        }
+    }
+    if (dropped)
+        // "SR: %04X: 3270 screen not saved: %s"   (here: screen saved, input records dropped)
+        WRMSG( HHC02033, "W", dev->devnum, "more than one terminal input record during Read Buffer; extra ones dropped" );
+    if (dev->rlen3270)
+        WRMSG( HHC02033, "W", dev->devnum, "incomplete terminal input record during Read Buffer dropped" );
+    dev->rlen3270    = 0;
+    dev->readpending = 0;
+    dev->tn->got_eor = FALSE;
+    dev->tn->eor_cnt = 0;
+    return *reply ? 0 : 0xFF;
+}
