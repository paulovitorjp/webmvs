 }
 
+/*-------------------------------------------------------------------*/
+/* Checkpoint one CCKD device.                                       */
+/* Called by the 'checkpoint' command (sr.c) while all CPUs are      */
+/* stopped and no channel program is active. Under the device's I/O  */
+/* lock: flush the cache and wait (at most waitms) until no write is */
+/* pending; then also under the file lock: harden (header, L1, free  */
+/* space, OPENED bit off) and copy every shadow file (index 1..sfn)  */
+/* into 'dir'. No CCKD thread (writer, garbage collector, hardener)  */
+/* can write to the file while both locks are held, so each copy is  */
+/* a clean, hardened image (cckdcdsk -3 rc 0).                       */
+/* Returns the number of files copied (0 = read-only device, no      */
+/* shadow), or -1 with a reason in 'err'.                            */
+/*-------------------------------------------------------------------*/
+static int cckd_ckpt_copy_file( int sfd, const char* dst, int dosync,
+                                U64* size, U32* crc, char* err, size_t errlen )
+{
+    struct stat st;
+    BYTE*  buf;
+    int    dfd;
+    U64    off = 0, total;
+    U32    c = crc32( 0L, Z_NULL, 0 );
+
+    if (fstat( sfd, &st ) < 0)
+    {
+        snprintf( err, errlen, "fstat: %s", strerror( errno ));
+        return -1;
+    }
+    total = (U64) st.st_size;
+    if (!(buf = malloc( 256 * 1024 )))
+    {
+        snprintf( err, errlen, "malloc: %s", strerror( errno ));
+        return -1;
+    }
+    dfd = HOPEN( dst, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, S_IRUSR | S_IWUSR | S_IRGRP );
+    if (dfd < 0)
+    {
+        snprintf( err, errlen, "open %s: %s", dst, strerror( errno ));
+        free( buf );
+        return -1;
+    }
+    while (off < total)
+    {
+        size_t  want = (size_t) MIN( (U64)(256 * 1024), total - off );
+        ssize_t n    = pread( sfd, buf, want, (off_t) off );
+        if (n <= 0)
+        {
+            snprintf( err, errlen, "read: %s", n < 0 ? strerror( errno ) : "short file" );
+            break;
+        }
+        if (write( dfd, buf, (size_t) n ) != n)
+        {
+            snprintf( err, errlen, "write %s: %s", dst, strerror( errno ));
+            break;
+        }
+        c = crc32( c, buf, (uInt) n );
+        off += (U64) n;
+    }
+    free( buf );
+    if (off == total && dosync && fsync( dfd ) < 0)
+    {
+        snprintf( err, errlen, "fsync %s: %s", dst, strerror( errno ));
+        off = total + 1;
+    }
+    if (close( dfd ) < 0 && off == total)
+    {
+        snprintf( err, errlen, "close %s: %s", dst, strerror( errno ));
+        off = total + 1;
+    }
+    if (off != total)
+        return -1;
+    *size = total;
+    *crc  = c;
+    return 0;
+}
+
+DLL_EXPORT int cckd_ckpt_dev( DEVBLK* dev, const char* dir, int dosync,
+                              int waitms, CCKD_CKPT_FILE* out, int maxout,
+                              char* err, size_t errlen )
+{
+CCKD_EXT       *cckd = dev->cckd_ext;
+struct timeval  now;
+struct timespec tm;
+int             i, n = 0, rc = 0;
+
+    if (!cckd)
+    {
+        snprintf( err, errlen, "not a CCKD device" );
+        return -1;
+    }
+    if (dev->cckd64)
+    {
+        snprintf( err, errlen, "CCKD64 devices are not supported" );
+        return -1;
+    }
+
+    gettimeofday( &now, NULL );
+    tm.tv_sec  = now.tv_sec + waitms / 1000;
+    tm.tv_nsec = (now.tv_usec + (waitms % 1000) * 1000) * 1000;
+    if (tm.tv_nsec >= 1000000000) { tm.tv_sec++; tm.tv_nsec -= 1000000000; }
+
+    obtain_lock( &cckd->cckdiolock );
+    if (cckd->merging || cckd->stopping)
+    {
+        release_lock( &cckd->cckdiolock );
+        snprintf( err, errlen, "device is merging or closing" );
+        return -1;
+    }
+
+    /* Write the cached updated tracks and wait for the writers */
+    cckd_flush_cache( dev );
+    while (cckd->wrpending || cckd->cckdioact)
+    {
+        cckd->cckdwaiters++;
+        rc = timed_wait_condition( &cckd->cckdiocond, &cckd->cckdiolock, &tm );
+        cckd->cckdwaiters--;
+        if (rc == ETIMEDOUT && (cckd->wrpending || cckd->cckdioact))
+        {
+            release_lock( &cckd->cckdiolock );
+            snprintf( err, errlen, "%d track writes still pending after %d ms%s",
+                      cckd->wrpending, waitms, cckd->cckdioact ? " (channel program active)" : "" );
+            return -1;
+        }
+        cckd_flush_cache( dev );
+    }
+
+    /* No new write can be scheduled while we hold the I/O lock, and */
+    /* no thread can write to the file while we hold the file lock.  */
+    obtain_lock( &cckd->filelock );
+    {
+        if (cckd->sfn == 0)
+        {
+            if (cckd->open[0] == CCKD_OPEN_RW && !dev->ckdrdonly)
+            {
+                snprintf( err, errlen, "base file is open read-write and there is no shadow file (sf=)" );
+                rc = -1;
+            }
+        }
+        else if (cckd_harden( dev ) < 0)
+        {
+            snprintf( err, errlen, "harden failed" );
+            rc = -1;
+        }
+        else
+        {
+            for (i = 1, rc = 0; i <= cckd->sfn && rc == 0; i++)
+            {
+                const char* sfname = cckd_sf_name( dev, i );
+                const char* base;
+                char        dst[ MAX_PATH ];
+
+                if (n >= maxout)
+                {
+                    snprintf( err, errlen, "too many shadow files" );
+                    rc = -1;
+                    break;
+                }
+                if (!sfname || cckd->fd[i] < 0)
+                {
+                    snprintf( err, errlen, "shadow file %d is not open", i );
+                    rc = -1;
+                    break;
+                }
+                base = strrchr( sfname, '/' );
+                base = base ? base + 1 : sfname;
+                out[n].devnum = dev->devnum;
+                out[n].sfx    = i;
+                STRLCPY( out[n].name, base );
+                STRLCPY( out[n].src,  sfname );
+                snprintf( dst, sizeof( dst ), "%s/%s", dir, out[n].name );
+                if (cckd_ckpt_copy_file( cckd->fd[i], dst, dosync,
+                                         &out[n].size, &out[n].crc, err, errlen ) < 0)
+                {
+                    rc = -1;
+                    break;
+                }
+                n++;
+            }
+        }
+    }
+    release_lock( &cckd->filelock );
+    release_lock( &cckd->cckdiolock );
+
+    return rc < 0 ? -1 : n;
+}
