+/* check a whole .srf before resume changes anything:                */
+/* identifier, build id (must be the first key after the id), the    */
+/* main storage size and CPU numbers, and that every unit can be     */
+/* read up to SR_EOF (a truncated or damaged gzip file fails here).  */
+/* Returns 0, -1 (damaged; reason in why) or -2 (build mismatch,     */
+/* message already issued).                                          */
+/*-------------------------------------------------------------------*/
+static int sr_check_file( SR_FILE file, char* why, size_t whylen )
+{
+U32      key = 0, len = 0;
+U64      mainsize = 0;
+int      cpu = 0;
+char     buf[ SR_MAX_STRING_LENGTH + 1 ];
+char     bid[ 512 ];
+
+    snprintf( why, whylen, "read error (damaged or truncated file)" );
+    sr_build_id( bid, sizeof( bid ));
+
+    SR_READ_HDR( file, key, len );
+    if (key != SR_HDR_ID || len > SR_MAX_STRING_LENGTH)
+    {
+        snprintf( why, whylen, "not a suspend/resume file" );
+        return -1;
+    }
+    SR_READ_STRING( file, buf, len );
+    if (strcmp( buf, SR_ID ))
+    {
+        snprintf( why, whylen, "not a suspend/resume file" );
+        return -1;
+    }
+    SR_READ_HDR( file, key, len );
+    if (key != SR_HDR_BUILD || len > SR_MAX_STRING_LENGTH)
+    {
+        // "SR: file has no build id (another Hercules build wrote it); this build is '%s'"
+        WRMSG( HHC02024, "E", bid );
+        return -2;
+    }
+    SR_READ_STRING( file, buf, len );
+    if (strcmp( buf, bid ))
+    {
+        // "SR: build mismatch: file was written by build '%s', this build is '%s'"
+        WRMSG( HHC02023, "E", buf, bid );
+        return -2;
+    }
+    for (;;)
