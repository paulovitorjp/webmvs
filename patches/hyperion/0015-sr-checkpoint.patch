+        SR_READ_HDR( file, key, len );
+        if (key == SR_EOF)
+            return 0;
+        if ((key & SR_KEY_ID_MASK) != SR_KEY_ID)
+        {
+            snprintf( why, whylen, "invalid key %8.8X", key );
+            return -1;
+        }
+        if (key == SR_SYS_MAINSIZE)
+        {
+            SR_READ_VALUE( file, len, &mainsize, sizeof( mainsize ));
+            if (mainsize > sysblk.mainsize)
+            {
+                snprintf( why, whylen, "mainsize %"PRIu64"M in the file, %"PRIu64"M configured",
+                          mainsize >> 20, (U64) sysblk.mainsize >> 20 );
+                return -1;
+            }
+        }
+        else if (key == SR_CPU)
+        {
+            SR_READ_VALUE( file, len, &cpu, sizeof( cpu ));
+            if (cpu < 0 || cpu >= sysblk.maxcpu)
+            {
+                snprintf( why, whylen, "processor %d in the file, at most %d configurable", cpu, sysblk.maxcpu );
+                return -1;
+            }
+        }
+        else
+            SR_READ_SKIP( file, len );
+    }
+}
