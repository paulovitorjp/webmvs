+/*-------------------------------------------------------------------*/
+/* checkpoint <dir> [options]                                        */
+/*                                                                   */
+/* Saves the running machine without ending Hercules:                */
+/*   1. stop the CPUs (at most 10 s)                                 */
+/*   2. wait until no I/O is queued or active (wait=, default 10 s)  */
+/*   3. every CCKD device: flush the cache, wait for the writes,     */
+/*      harden, and copy each shadow file to <dir>/<file name>,      */
+/*      all under the device's CCKD I/O and file locks               */
+/*   4. write <dir>/machine.srf (the suspend file; gzip level=)      */
+/*   5. start the CPUs again                                         */
+/*   6. write <dir>/checkpoint.json (written last: the directory is  */
+/*      a valid checkpoint only if it exists and ends with "end")    */
+/* On any error: start the CPUs again, delete nothing that was       */
+/* valid before except <dir>/checkpoint.json (removed at the start), */
+/* message HHC02031E. Success: HHC02030I.                            */
+/* Options: level=0..9 (gzip, 0 = no compression; default 1)         */
+/*          wait=<ms>  (I/O drain and CCKD write limit; 10000)       */
+/*          screens=<ms> (3270 Read Buffer reply limit per terminal, */
+/*                   0 = do not save the screens; default 2000)      */
+/*          sync=0|1   (fsync the files; default 1)                  */
+/*-------------------------------------------------------------------*/
+#define CKPT_MAXFILES 64
+
+static int ckpt_file_crc( const char* path, U64* size, U32* crc, int dosync )
+{
+    BYTE    buf[ 64 * 1024 ];
+    ssize_t n;
+    U32     c = crc32( 0L, Z_NULL, 0 );
+    U64     s = 0;
+    int     fd = HOPEN( path, O_RDONLY | O_BINARY );
+    if (fd < 0)
+        return -1;
+    while ((n = read( fd, buf, sizeof( buf ))) > 0)
+    {
+        c = crc32( c, buf, (uInt) n );
+        s += (U64) n;
+    }
+    if (dosync)
+        fsync( fd );
+    close( fd );
+    if (n < 0)
+        return -1;
+    *size = s;
+    *crc  = c;
+    return 0;
+}
