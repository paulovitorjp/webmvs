+            if (IS_CPU_ONLINE(i))
+                online++;
+        for (i = 0; !online && i < (ncpu0 ? ncpu0 : 1) && i < sysblk.maxcpu; i++)
+            configure_cpu(i);
+        RELEASE_INTLOCK(NULL);
+        // "SR: resume failed after the machine was changed; processors configured again, IPL (clear) needed"
+        WRMSG(HHC02027, "W");
+    }
     return -1;
 }
 
