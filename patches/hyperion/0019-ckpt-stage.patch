+/*-------------------------------------------------------------------*/
+/* Checkpoint staging (patch 0019).                                  */
+/* stage=<dir> writes the shadow copies (full), shadows.dlt (delta)  */
+/* and machine.srf into <dir> while the CPUs are stopped, and copies */
+/* them into the checkpoint directory after the CPUs run again (same */
+/* bytes, same CRCs; the checkpoint is valid only when               */
+/* checkpoint.json exists, which is still written last). The browser */
+/* build stages in the WasmFS memory directory /tmp/ckpt-stage by    */
+/* default: on OPFS every file create, write, fsync and close is a   */
+/* round trip to the OPFS proxy thread (Firefox: 30-50 ms per file), */
+/* which made up most of the pause. stage= (empty) turns staging     */
+/* off; native default: off.                                         */
+/*-------------------------------------------------------------------*/
+static U64 ckpt_hint_srf = 0;           /* largest machine.srf so far  */
+static U64 ckpt_hint_dlt = 0;           /* largest shadows.dlt so far  */
+
+static void ckpt_clear_stage( const char* stage )
+{
+    DIR*            d;
+    struct dirent*  e;
+    char            p[ MAX_PATH ];
+
+    if (!(d = opendir( stage )))
+        return;
+    while ((e = readdir( d )))
+    {
+        if (!strcmp( e->d_name, "." ) || !strcmp( e->d_name, ".." ))
+            continue;
+        snprintf( p, sizeof( p ), "%s/%s", stage, e->d_name );
+        unlink( p );
+    }
+    closedir( d );
+}
+
+/* Give a staged file its capacity before the pause: a WasmFS memory */
+/* file keeps its capacity when it is opened again with O_TRUNC, so  */
+/* the small writes of gzip / ckdlt_put do not grow (and copy) the   */
+/* buffer again and again (0019: that left the heap about 7.5 MiB    */
+/* higher in a soak). Only a hint: errors are ignored.               */
+static void ckpt_presize( const char* path, U64 last, U64 dflt )
+{
+    int   fd = HOPEN( path, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, S_IRUSR | S_IWUSR );
+    off_t want = (off_t)(last ? last + last / 4 + 65536 : dflt);
+
+    if (fd < 0)
+        return;
+    if (ftruncate( fd, want ) < 0)
+        want = 0;
+    close( fd );
+}
+
+static int ckpt_move_file( const char* src, const char* dst, int dosync, char* err, size_t errlen )
+{
+    BYTE*   buf;
+    ssize_t n;
+    int     sfd, dfd, rc = 0;
+
+    if ((sfd = HOPEN( src, O_RDONLY | O_BINARY )) < 0)
+    {
+        snprintf( err, errlen, "open %s: %s", src, strerror( errno ));
+        return -1;
+    }
+    if (!(buf = malloc( 256 * 1024 )))
+    {
+        snprintf( err, errlen, "malloc: %s", strerror( errno ));
+        close( sfd );
+        return -1;
+    }
+    dfd = HOPEN( dst, O_WRONLY | O_CREAT | O_TRUNC | O_BINARY, S_IRUSR | S_IWUSR | S_IRGRP );
+    if (dfd < 0)
+    {
+        snprintf( err, errlen, "open %s: %s", dst, strerror( errno ));
+        free( buf );
+        close( sfd );
+        return -1;
+    }
+    while ((n = read( sfd, buf, 256 * 1024 )) > 0)
+    {
+        if (write( dfd, buf, (size_t) n ) != n)
+        {
+            snprintf( err, errlen, "write %s: %s", dst, strerror( errno ));
+            rc = -1;
+            break;
+        }
+    }
+    if (n < 0 && rc == 0)
+    {
+        snprintf( err, errlen, "read %s: %s", src, strerror( errno ));
+        rc = -1;
+    }
+    if (rc == 0 && dosync && fsync( dfd ) < 0)
+    {
+        snprintf( err, errlen, "fsync %s: %s", dst, strerror( errno ));
+        rc = -1;
+    }
+    if (close( dfd ) < 0 && rc == 0)
+    {
+        snprintf( err, errlen, "close %s: %s", dst, strerror( errno ));
+        rc = -1;
+    }
+    free( buf );
+    close( sfd );
+    unlink( src );
+    return rc;
+}
